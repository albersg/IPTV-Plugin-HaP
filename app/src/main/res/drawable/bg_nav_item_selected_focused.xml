<?xml version="1.0" encoding="utf-8"?>
<!-- Selected and focused at once: the selected surface plus the accent outline. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@drawable/bg_nav_item_selected" />
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke
                android:width="@dimen/hap_focus_stroke"
                android:color="@color/hap_accent" />
            <corners android:radius="@dimen/hap_nav_radius" />
        </shape>
    </item>
</layer-list>
