<?xml version="1.0" encoding="utf-8"?>
<!-- Selected but not focused: subtle raised fill plus the accent bar on the left. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/hap_surface_raised" />
            <corners android:radius="@dimen/hap_nav_radius" />
        </shape>
    </item>
    <item
        android:width="4dp"
        android:height="26dp"
        android:gravity="left|center_vertical">
        <shape android:shape="rectangle">
            <solid android:color="@color/hap_accent" />
            <corners android:radius="2dp" />
        </shape>
    </item>
</layer-list>
