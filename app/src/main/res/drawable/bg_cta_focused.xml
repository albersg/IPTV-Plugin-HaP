<?xml version="1.0" encoding="utf-8"?>
<!--
    Focused CTA. An accent outline would vanish on an accent fill, so the pressed accent is the
    fill instead and the outline is the primary text colour: still one outline, still unmistakable.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/hap_accent_pressed" />
    <stroke
        android:width="@dimen/hap_focus_stroke"
        android:color="@color/hap_text_primary" />
    <corners android:radius="@dimen/hap_card_radius" />
</shape>
