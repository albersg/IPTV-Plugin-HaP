<?xml version="1.0" encoding="utf-8"?>
<!--
    HaP dimensions for narrow screens (phones, small tablets).

    The TV values of the approved mockup live in res/values-w600dp/dimens.xml: a 300dp rail and
    the 48dp/32dp TV-safe inset. The qualifier is *available width*, not smallest width, because
    an Android TV box usually reports 960x540dp: its width matches a TV comfortably while its
    smallest width does not. On a phone those numbers would leave no room for content, so the same
    names carry smaller values here. Both files must define the same names.
-->
<resources>
    <dimen name="hap_screen_padding_horizontal">16dp</dimen>
    <dimen name="hap_screen_padding_vertical">16dp</dimen>

    <dimen name="hap_rail_width">168dp</dimen>
    <dimen name="hap_rail_content_gap">12dp</dimen>
    <dimen name="hap_nav_item_height">48dp</dimen>
    <dimen name="hap_nav_item_padding">12dp</dimen>

    <dimen name="hap_gap_block">16dp</dimen>
    <dimen name="hap_gap_row">10dp</dimen>

    <dimen name="hap_card_padding">16dp</dimen>
    <dimen name="hap_card_radius">12dp</dimen>
    <dimen name="hap_nav_radius">10dp</dimen>
    <dimen name="hap_focus_stroke">2dp</dimen>
    <dimen name="hap_hairline">1dp</dimen>

    <!--
        The channel list scrolls inside this height instead of growing with the page. A bounded
        height is what lets the recycler keep only a viewport of rows measured and attached; the
        page keeps scrolling for everything above and below it.
    -->
    <dimen name="hap_channel_list_height">240dp</dimen>

    <dimen name="hap_status_dot">10dp</dimen>
    <dimen name="hap_chevron">20dp</dimen>

    <!--
        The phone shell's own measurements: the height of the four-entry bottom bar (icon above a
        label, so it is taller than a rail entry) and the square of the top bar's two icon actions.
        res/values-w600dp/dimens.xml defines the same names, unused by the television layout, so
        both files stay in sync.
    -->
    <dimen name="hap_bottom_bar_height">64dp</dimen>
    <dimen name="hap_touch_action_size">44dp</dimen>
</resources>
