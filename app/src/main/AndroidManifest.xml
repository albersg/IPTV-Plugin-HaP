<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="MissingLeanbackLauncher">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- In-app updater: lets the system installer ask the user to confirm a downloaded update.
         No silent install path exists; the user always confirms in the system UI. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <application
        android:allowBackup="false"
        android:banner="@drawable/banner_hap"
        android:icon="@drawable/ic_hap_plugin"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".HapConfigActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.streamvault.plugin.hap.CONFIGURE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!--
            "Cómo ver mis canales" (S4). Its own activity, so the five-section shell and its tests
            stay untouched; not exported, because only HaP itself opens it, and deliberately not a
            launcher entry: it is reached from the home screen's dominant action.
        -->
        <activity
            android:name=".ConnectPlayerActivity"
            android:exported="false"
            android:label="@string/home_cta_title"
            android:theme="@style/AppTheme" />

        <!--
            The first-run assistant (T8). Its own activity, reached from one card on Inicio, so the
            five-section shell and its tests stay untouched. Not exported: only HaP opens it, and it
            is never a launcher entry, because it must appear only while HaP has nothing to serve.
        -->
        <activity
            android:name=".FirstRunActivity"
            android:exported="false"
            android:label="@string/first_run_title"
            android:theme="@style/AppTheme" />

        <!--
            D1: the StreamVault plugin service is CLOSED, so the plugin integration is inactive.

            It has to be unreachable because it authorised nobody: any installed app could bind
            com.streamvault.plugin.API and start/stop the runtime, enable LAN exposure and read the
            stored provider URLs, credentials included. Neither check that would fix that can work
            here — this fork is signed with a different key than StreamVault (so a signature
            permission would refuse the legitimate caller) and StreamVault is not installed on the
            device this build targets (so a package allowlist has no host to name).

            Reopening is a deliberate one-line act, once StreamVault is installed: change
            android:exported="false" to android:exported="true" on this service. Nothing else is
            needed — the intent filter, the Binder ABI in StreamVaultHapPluginService and every
            com.streamvault.plugin.* metadata value below are kept exactly as they were, so
            reopening restores the integration with no other edit.
        -->
        <service
            android:name=".StreamVaultHapPluginService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.streamvault.plugin.API" />
            </intent-filter>
            <meta-data
                android:name="com.streamvault.plugin.MANIFEST_JSON"
                android:value="{&quot;schemaVersion&quot;:1,&quot;id&quot;:&quot;com.streamvault.plugins.hap&quot;,&quot;name&quot;:&quot;HaP&quot;,&quot;versionName&quot;:&quot;1.4.1&quot;,&quot;versionCode&quot;:16,&quot;description&quot;:&quot;AceStream and IPFS IPTV player server, also usable as a StreamVault companion plugin.&quot;,&quot;providerName&quot;:&quot;HaP AIO&quot;,&quot;configurationMode&quot;:&quot;activity&quot;,&quot;configurationActivityAction&quot;:&quot;com.streamvault.plugin.hap.CONFIGURE&quot;,&quot;capabilities&quot;:[&quot;provider.m3u&quot;,&quot;playback.prepare&quot;,&quot;cast.rewriteUrl&quot;,&quot;configuration.activity&quot;]}" />
            <meta-data
                android:name="com.streamvault.plugin.ID"
                android:value="com.streamvault.plugins.hap" />
            <meta-data
                android:name="com.streamvault.plugin.NAME"
                android:value="HaP" />
            <meta-data
                android:name="com.streamvault.plugin.VERSION_NAME"
                android:value="1.4.1" />
            <meta-data
                android:name="com.streamvault.plugin.VERSION_CODE"
                android:value="16" />
            <meta-data
                android:name="com.streamvault.plugin.DESCRIPTION"
                android:value="AceStream and IPFS IPTV player server, also usable as a StreamVault companion plugin." />
            <meta-data
                android:name="com.streamvault.plugin.PROVIDER_NAME"
                android:value="HaP AIO" />
            <meta-data
                android:name="com.streamvault.plugin.CONFIGURATION_MODE"
                android:value="activity" />
            <meta-data
                android:name="com.streamvault.plugin.CONFIGURATION_ACTIVITY_ACTION"
                android:value="com.streamvault.plugin.hap.CONFIGURE" />
            <meta-data
                android:name="com.streamvault.plugin.CAPABILITIES"
                android:value="provider.m3u,playback.prepare,cast.rewriteUrl,configuration.activity" />
        </service>

        <service
            android:name="com.jopsis.httpaceserveproxy.ProxySupervisorService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <receiver
            android:name="com.jopsis.httpaceserveproxy.ExternalPlayerServerReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Explicit, non-exported target for the PackageInstaller status PendingIntent: the
             update screen reads the stored result when it comes back to the foreground. -->
        <receiver
            android:name="com.jopsis.httpaceserveproxy.UpdateInstallReceiver"
            android:exported="false" />
    </application>
</manifest>
